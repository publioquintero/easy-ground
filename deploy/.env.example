# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# The Google key goes in backend/.env (GOOGLE_MAPS_API_KEY=...), as in development.

# Subdomain pointing (DNS A record) to the server's IP, e.g. ruta.example.com
DOMAIN=
# Login for the app. Hash with:
#   docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your-password'
# In this file, write every "$" of the hash as "$$" (compose reads "$" as a variable).
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Long random values, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
S3_ACCESS_KEY=easyground
S3_SECRET_KEY=
