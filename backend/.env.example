# Copy to .env — never commit .env
DATABASE_URL=postgresql://easyground:easyground@localhost:5432/easyground
REDIS_URL=redis://localhost:6379/0
# S3-compatible storage (RustFS in docker-compose)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=easyground
S3_SECRET_KEY=easyground-dev-secret
S3_BUCKET=easy-ground
GOOGLE_MAPS_API_KEY=
# auto = Google when GOOGLE_MAPS_API_KEY is set, otherwise the free US Census geocoder
GEOCODER=auto
